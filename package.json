{
  "name": "dsh-claude-mode",
  "version": "1.1.2",
  "private": true,
  "description": "Claude Code 风格的 Prompt Pilot：空输入框先给完整本地草稿，再由当前模型按会话上下文完善目标、范围、约束与验收方式；同一上下文只调用一次并复用缓存；Tab 接受后删除会重新出现。另含只读的数据与存储审计、迁移脚本和临时目录清理脚本。",
  "author": "dsh-claude-mode contributors",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "lib",
    "scripts",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "NOTICE",
    "LICENSE",
    "docs",
    "test"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check": "node --check index.js && node --check client.js && node scripts/build-client.mjs --check",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "eval:pilot": "node scripts/eval-prompt-pilot.mjs",
    "eval:data": "node scripts/eval-data-keeper.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "claude-code",
    "theme",
    "command-palette",
    "statusline",
    "ui",
    "chat-search",
    "read-aloud",
    "prompt-completion",
    "ai-prompts",
    "chatgpt-desktop"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-shortcuts"
      ],
      "manifestVersion": 1
    }
  },
  "engines": {
    "node": ">=22"
  }
}

