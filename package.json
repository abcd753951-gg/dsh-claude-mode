{
  "name": "dsh-claude-mode",
  "version": "0.5.0",
  "private": true,
  "description": "Claude Code 风格的界面与交互层：中性灰配陶土橙、脉冲状态星、提示词历史、快捷键一览、侧边栏与插件图标折叠、命令面板（含聊天记录搜索）、朗读与完成提示音、回合完成页脚。",
  "author": "dsh-claude-mode contributors",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "scripts",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "NOTICE",
    "LICENSE",
    "docs",
    "test"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check": "node --check index.js && node --check client.js && node scripts/build-client.mjs --check",
    "test": "node --test \"test/unit/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "claude-code",
    "theme",
    "command-palette",
    "statusline",
    "ui",
    "chat-search",
    "read-aloud",
    "chatgpt-desktop"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-shortcuts"
      ],
      "manifestVersion": 1
    }
  },
  "engines": {
    "node": ">=22"
  }
}
